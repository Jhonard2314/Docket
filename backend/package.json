{
  "name": "docket-backend",
  "version": "1.0.0",
  "description": "Docket Document Management System — Express + TypeScript backend",
  "main": "dist/app.js",
  "scripts": {
    "build":        "tsc",
    "start":        "node dist/app.js",
    "dev":          "ts-node-dev --respawn --transpile-only src/app.ts",
    "db:generate":  "prisma generate",
    "db:migrate":   "prisma migrate dev",
    "db:push":      "prisma db push",
    "db:seed":      "ts-node --transpile-only prisma/seed.ts",
    "db:studio":    "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3":           "^3.0.0",
    "@aws-sdk/s3-request-presigner":"^3.0.0",
    "@prisma/client":               "^7.0.0",
    "better-auth":                  "^1.0.0",
    "cors":                         "^2.8.5",
    "dotenv":                       "^16.0.3",
    "express":                      "^4.18.2",
    "multer":                       "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/multer":  "^1.4.11",
    "@types/node":    "^20.0.0",
    "prisma":         "^7.0.0",
    "ts-node":        "^10.9.2",
    "ts-node-dev":    "^2.0.0",
    "typescript":     "^5.0.0"
  }
}
