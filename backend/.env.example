# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL / Amazon RDS ───────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/docket_db

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change_this_to_a_long_random_string_in_production
BETTER_AUTH_URL=http://localhost:3000

# ── Amazon S3 ─────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-s3-bucket-name

# ── Seed credentials (never commit real passwords) ────────────────────────────
SEED_ADMIN_EMAIL=admin@docket.local
SEED_ADMIN_PASSWORD=Docket123!
SEED_ADMIN_NAME=System Administrator

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5500

# ── On EC2: remove AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# ── Use an IAM Role attached to the instance instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
